{
  "all": true,
  "include": ["main.js"],
  "exclude": ["node_modules/**", "tests/**", "componentes/**", "scripts/**"],
  "reporter": ["text", "html", "lcov", "json-summary"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "per-file": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 80
}
