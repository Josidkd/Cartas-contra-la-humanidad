{
  "name": "cartas-contra-la-humanidad",
  "version": "0.2.0",
  "private": true,
  "description": "Juego local de cartas para compartir un dispositivo",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test:coverage",
    "test:unit": "node --test tests/game.test.cjs tests/server.test.cjs tests/build-web.test.cjs tests/android-release.test.cjs",
    "test:coverage": "c8 npm run test:unit",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.cjs",
    "build:web": "node scripts/build-web.cjs",
    "android:sync": "npm run build:web && cap sync android",
    "quality": "npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "c8": "11.0.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.10.1"
  }
}
